      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (effect) (rate(keystone_tool_calls_total[1m]))",
          "legendFormat": "{{effect}}"
