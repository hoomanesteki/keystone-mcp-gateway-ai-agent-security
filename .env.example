# Host ports for the local compose stack. Copy to .env to move one.
# The values below are the defaults used when .env is absent.
POSTGRES_PORT=55432
REDIS_PORT=56379
KEYCLOAK_PORT=8180
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MAIL_PORT=8101
FILES_PORT=8102
BANK_PORT=8103
ECHO_PORT=8104
WEB_PORT=8105
KEYSTONE_PORT=8080
FILES_GLOBEX_PORT=8112

# Ports for services that arrive in later phases. Compose does not read these yet.
FAKE_LLM_PORT=8199

# The console is the Vite dev server of console/ (`pnpm dev`) and not a compose service. Its port is
# 5173 and cannot be moved with a variable: the Keycloak client `console` allows
# http://localhost:5173/* and nothing else (deploy/keycloak/realm-keystone.json).

# ---------------------------------------------------------------------------------------------
# DEVELOPMENT ONLY. Everything in this block is public, because this file is in the repository.
# They are the defaults of the local compose stack and of scripts/get_token.sh. Never use any
# of them on a machine other than your own, and never in a deployment. The same values are the
# defaults in deploy/docker-compose.yml; tests/unit/test_dev_secrets.py fails if the two differ.
# Put your own values in .env to change them. A variable already set in your shell wins over both.
# ---------------------------------------------------------------------------------------------

# Passwords of the Keycloak users in deploy/keycloak/realm-keystone.json.
ALICE_PASSWORD=alice-dev-password
OLIVIA_PASSWORD=olivia-dev-password
LENA_PASSWORD=lena-dev-password
BOB_PASSWORD=bob-dev-password
ROOT_PASSWORD=root-dev-password

# Secrets of the confidential Keycloak clients.
SUPPORT_AGENT_SECRET=support-agent-dev-secret
OPS_AGENT_SECRET=ops-agent-dev-secret
KEYSTONE_CLI_SECRET=keystone-cli-dev-secret

# The database role Keystone runs as (KS-503). It may read and write every table, but on the audit log
# only add and read records. The migration that creates it uses this password unless
# KEYSTONE_APP_DB_PASSWORD is set, and it refuses to run with KEYSTONE_ENV=prod and no password.
KEYSTONE_APP_DB_PASSWORD=keystone-app-dev-password

# Keystone's vault key: a Fernet key. Comma-separate several to rotate (the first encrypts, every
# one decrypts). Make a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYSTONE_MASTER_KEYS=FpAPqO9j92_C-qEbO6vqkdH2olOR4ZHKzRqM7OhjSE0=

# The API keys the demo upstreams require in X-Api-Key. Keystone reads them at startup and stores
# them encrypted in its vault; agents never see them.
MAIL_API_KEY=dev-mail-key-3f9a1c7d
FILES_API_KEY=dev-files-key-81b2e04f
BANK_API_KEY=dev-bank-key-c6d57a92
ECHO_API_KEY=dev-echo-key-0e4b9d13
WEB_API_KEY=dev-web-key-9d3b6e21
FILES_GLOBEX_API_KEY=dev-globex-key-5a7c28e6

# Keystone settings (read by `keystone serve`; see docs/runbook.md).
# The model behind the scanner's rules: protectai-deberta-v2, prompt-guard-2-86m or none. It needs
# the extra keystone[scanner]; the compose image has it.
# KEYSTONE_SCANNER_CLASSIFIER=none
# KEYSTONE_ENV=dev
# KEYSTONE_DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:55432/keystone
# KEYSTONE_REDIS_URL=redis://localhost:56379/0
# KEYSTONE_LOG_LEVEL=INFO
# KEYSTONE_CONFIG=keystone.yaml
# Allow upstream URLs that resolve to loopback, private or link-local addresses. Local setups only.
# KEYSTONE_ALLOW_PRIVATE_UPSTREAMS=false
# Sign-in. Compose sets these. For `keystone serve` against the compose Keycloak:
# KEYSTONE_OIDC_ISSUER=http://localhost:8180/realms/keystone
# KEYSTONE_OIDC_AUDIENCE=keystone
# KEYSTONE_OIDC_DISCOVERY_URL=   (only when Keystone reaches Keycloak at another address)
# KEYSTONE_PUBLIC_BASE_URL=http://localhost:8080
# KEYSTONE_AUTH__MODE=none   (dev and test only: every caller is the dev principal)
# Seconds between health probes of the upstreams (0 turns them off), and how many failures make one down.
# KEYSTONE_HEALTH__INTERVAL_S=30   (in compose, set KEYSTONE_HEALTH_INTERVAL_S instead)
# KEYSTONE_HEALTH__DOWN_AFTER=3
